# preprocessing of dataset
def get_formatted_dataset(data):
  # get viedoe name and group data  -2 means video name
  fname=data['filename'].iloc[1].split("/")
  num= len(fname)

  data['client_vidname']    = data['filename'].str.split("/", expand=True)[num-2]+'_'+data['filename'].str.split("/", expand=True)[num-1]
  q                         = data.groupby(["client_vidname"])["filename"].count().rename('c1')
  df=pd.DataFrame()
  for vidname in q.keys():
    num_frame=q[vidname]

    frames_to_get=32
    if(num_frame<24):
      frames_to_get=16
    elif num_frame<32:
      frames_to_get=24
    this_df=data[data.client_vidname == vidname].head(frames_to_get)
    df=pd.concat([df,this_df],ignore_index=True)
  df['filename'] = df['filename'].str.replace('drive/MyDrive/ML_Data/Datasets_Preprocessed/','')
  df['filename'] = df['filename'].str.replace('_Files_frames','')
  df['filename'] = df['filename'].str.replace('Train_Files','Train')

  return df

