def image_data_augmentation(df,folder_frames, batch_size=8, target_size=(224, 224)):    # i change batch size 8 to 16
         # Load frames in batches for augmentation25
         train_gen = ImageDataGenerator( rescale=1./255, horizontal_flip=True            )
         return train_gen.flow_from_dataframe(
             dataframe = df,
             directory = folder_frames ,
             x_col = "filename", y_col = "label" ,
             target_size=target_size,
             batch_size=batch_size,
             class_mode='categorical',  # Assuming categorical labels (adjust if needed)
             shuffle=False,  # Shuffle frames within each batch
             seed=42,  # Set random seed for reproducibility (optional)
            )
